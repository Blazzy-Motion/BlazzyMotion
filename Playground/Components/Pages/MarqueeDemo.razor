@page "/marqueedemo"
@using BlazzyMotion.Core.Models
@using BlazzyMotion.Marquee.Components
@using BlazzyMotion.Marquee.Models
@using Playground.Models

<PageTitle>Marquee Demo - BlazzyMotion Playground</PageTitle>

<div class="bz-home">

    <section class="bz-hero" style="min-height: auto; padding: 4rem 2rem;">
        <div class="bz-hero__content">
            <h1 class="bz-hero__brand">BzMarquee</h1>
            <h2 class="bz-hero__title">Infinite Scrolling Content</h2>
            <p class="bz-hero__subtitle">CSS-driven marquee with logo bars, testimonials, and text tickers</p>
        </div>
    </section>

    <!-- Logo Bar Mode -->
    <section class="bz-demo">
        <span class="bz-demo__label">Logo Bar — Multi-Row</span>
        <h3 class="bz-demo__title">Trusted By Industry Leaders</h3>

        <div class="bz-theme-pills">
            <button class="bz-pill @(_currentTheme == BzTheme.Glass ? "active" : "")"
                    @onclick="() => ChangeTheme(BzTheme.Glass)">
                <span class="bz-pill__icon">@Icons.Crystal</span> Glass
            </button>
            <button class="bz-pill @(_currentTheme == BzTheme.Dark ? "active" : "")"
                    @onclick="() => ChangeTheme(BzTheme.Dark)">
                <span class="bz-pill__icon">@Icons.Moon</span> Dark
            </button>
            <button class="bz-pill @(_currentTheme == BzTheme.Light ? "active" : "")"
                    @onclick="() => ChangeTheme(BzTheme.Light)">
                <span class="bz-pill__icon">@Icons.Sun</span> Light
            </button>
            <button class="bz-pill @(_currentTheme == BzTheme.Minimal ? "active" : "")"
                    @onclick="() => ChangeTheme(BzTheme.Minimal)">
                <span class="bz-pill__icon">@Icons.Minus</span> Minimal
            </button>
        </div>

        <div class="bz-demo__stage" style="margin-top: 24px;">
            <BzMarquee TItem="MarqueeBrand"
                       Items="@_brands"
                       Theme="@_currentTheme"
                       Speed="30"
                       Gap="40"
                       Rows="2"
                       AlternateDirection="true"
                       PauseOnHover="true"
                       ShowGradientEdges="true"
                       StaggerEntrance="true">
                <ItemTemplate Context="brand">
                    <div class="bzm-logo-item" aria-label="@brand.Name logo">
                        @Icons.GetCompanyLogo(brand.Name)
                        <span style="margin-left: 8px; font-size: 0.9rem; font-weight: 500; white-space: nowrap;">@brand.Name</span>
                    </div>
                </ItemTemplate>
            </BzMarquee>
        </div>
    </section>

    <!-- Testimonials Mode -->
    <section class="bz-demo">
        <span class="bz-demo__label">Testimonials</span>
        <h3 class="bz-demo__title">What Developers Say</h3>

        <div class="bz-demo__stage">
            <BzMarquee TItem="MarqueeTestimonial"
                       Items="@_testimonials"
                       Theme="@_currentTheme"
                       Speed="30"
                       Gap="24"
                       PauseOnHover="true"
                       ShowGradientEdges="true"
                       StaggerEntrance="true" />
        </div>
    </section>

    <!-- Text Ticker Mode -->
    <section class="bz-demo">
        <span class="bz-demo__label">Text Ticker</span>
        <h3 class="bz-demo__title">Breaking News Ticker</h3>

        <div class="bz-demo__stage">
            <BzMarquee TItem="MarqueeBrand"
                       Text="BlazzyMotion — Premium Blazor Components — Carousel — Bento Grid — Gallery — Marquee — Built with .NET 8"
                       Theme="@_currentTheme"
                       Speed="60"
                       ShowGradientEdges="true"
                       StaggerEntrance="true" />
        </div>
    </section>

    <!-- Clickable Items -->
    <section class="bz-demo">
        <span class="bz-demo__label">Clickable Items</span>
        <h3 class="bz-demo__title">Click to Select</h3>

        <div class="bz-demo__stage">
            <BzMarquee TItem="MarqueeBrand"
                       Items="@_clickableBrands"
                       Theme="@_currentTheme"
                       Speed="45"
                       Gap="24"
                       PauseOnHover="true"
                       OnItemClick="@OnBrandClick" />
        </div>

        @if (_selectedBrand != null)
        {
            <div style="text-align: center; margin-top: 24px;">
                <img src="@_selectedBrand.ImageUrl" alt="@_selectedBrand.Name"
                     style="width: 120px; height: 120px; object-fit: cover; border-radius: 16px; box-shadow: 0 8px 32px rgba(0,0,0,0.3);" />
                <h4 class="bz-selected-title">@_selectedBrand.Name</h4>
            </div>
        }
    </section>

</div>

@code {
    private BzTheme _currentTheme = BzTheme.Glass;
    private MarqueeBrand? _selectedBrand;

    private List<MarqueeBrand> _brands = new()
    {
        new() { Name = "Apple" },
        new() { Name = "Microsoft" },
        new() { Name = "Google" },
        new() { Name = "Amazon" },
        new() { Name = "Tesla" },
        new() { Name = "Meta" },
        new() { Name = "Nvidia" },
        new() { Name = "Netflix" }
