        },
        new()
        {
            Name = "Elena Kowalski",
            Avatar = "images/companies/google.webp",
            Quote = "The stagger entrance and infinite scroll feel so polished. Our marketing page finally has that premium touch."
        },
        new()
        {
            Name = "James Okafor",
