<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.4.1</PackageValidationBaselineVersion>
    <Version>$(BlazzyCarouselVersion)</Version>
    <PackageVersion>$(BlazzyCarouselVersion)</PackageVersion>
    <PackageId>BlazzyMotion.Carousel</PackageId>
    <Title>BlazzyMotion 3D Carousel</Title>
    <Description>A beautiful 3D carousel component for Blazor with Glassmorphism design and Coverflow effect. Features zero-config setup with [BzImage] attribute and automatic template generation via Source Generator. Live demo: https://blazzymotion.com/</Description>
    <PackageTags>blazor;carousel;3d;swiper;coverflow;ui;component;glassmorphism;source-generator</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Use the updated shared runtime to keep nested touch gestures steady during ancestor attribute updates. Refine four themes while retaining Coverflow dimensions; add accessible navigation, mapped-image loading fallbacks and suppression of unchanged-index notifications. Requires BlazzyMotion.Core 1.4.0 or later.</PackageReleaseNotes>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazzyMotion.Core\BlazzyMotion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" Condition="Exists('icon.png')" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
