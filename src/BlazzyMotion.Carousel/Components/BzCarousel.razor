@namespace BlazzyMotion.Carousel.Components
@using Microsoft.AspNetCore.Components.Web
@typeparam TItem where TItem : class
@inherits BlazzyMotion.Core.Abstractions.BzComponentBase

@if (IsLoading)
{
    <div class="bzc-loading" @attributes="AdditionalAttributes">
        @if (LoadingTemplate != null)
        {
            @LoadingTemplate
        }
        else
        {
            <div class="bzc-spinner"></div>
            <p>Loading carousel...</p>
        }
    </div>
}
else if (IsEmpty)
{
    <div class="bzc-empty" @attributes="AdditionalAttributes">
        @if (EmptyTemplate != null)
        {
            @EmptyTemplate
        }
        else
        {
            <p>No items to display</p>
        }
    </div>
}
else
{
    <div class="@GetCombinedClass("bzc-carousel-box")" style="@GetContainerStyle()" @ref="_carouselRef" data-item-count="@ItemCount"
        role="region" aria-roledescription="carousel" aria-label="Carousel" tabindex="0"
        @attributes="AdditionalAttributes">
        <p class="bzc-sr-only">Use Left and Right Arrow keys to browse slides. Use Tab to reach slide content.</p>
        <div class="swiper-container bzc-pending">
            <div class="swiper-wrapper">
                @{
                    var index = 0;
                    foreach (var item in Items!)
                    {
                        var currentIndex = index;
                        var hasImage = _useRegistryMapping && currentIndex < _mappedItems.Count && _mappedItems[currentIndex].HasImage;
                        <div class="swiper-slide" role="group" aria-roledescription="slide"
                             aria-label="@($"{currentIndex + 1} of {ItemCount}")"
                             data-bzc-media="@(hasImage ? "loading" : null)"
                             data-bzc-selectable="@(OnItemSelected.HasDelegate ? "true" : "false")"
                             @onclick="() => HandleItemClick(item)">
                            @GetItemContent(item, currentIndex)
                            @if (hasImage)
                            {
                                <span class="bzc-media-placeholder" aria-hidden="true">Loading image</span>
                            }
                            @if (ShowOverlay)
                            {
                                <div class="bzc-overlay"></div>
                            }
                        </div>
                        index++;
                    }
                }
            </div>
        </div>
        @if (ItemCount > 1)
        {
            <button type="button" disabled class="bzc-keyboard-control bzc-previous" data-bzc-direction="previous" aria-label="Previous slide">Previous</button>
            <button type="button" disabled class="bzc-keyboard-control bzc-next" data-bzc-direction="next" aria-label="Next slide">Next</button>
        }
        <span class="bzc-sr-only bzc-status" role="status" aria-live="polite" aria-atomic="true"></span>
    </div>
}