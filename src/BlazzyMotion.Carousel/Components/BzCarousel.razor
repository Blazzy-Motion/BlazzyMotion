@namespace BlazzyMotion.Carousel.Components
@using Microsoft.AspNetCore.Components.Web
@using BlazzyMotion.Carousel.Models
@typeparam TItem where TItem : class
@inherits BlazzyMotion.Core.Abstractions.BzComponentBase

@if (IsLoading)
{
    <div class="bzc-loading" @attributes="AdditionalAttributes">
        @if (LoadingTemplate != null)
        {
            @LoadingTemplate
        }
        else
        {
            <div class="bzc-spinner"></div>
            <p>Loading carousel...</p>
        }
    </div>
}
else if (IsEmpty)
{
    <div class="bzc-empty" @attributes="AdditionalAttributes">
        @if (EmptyTemplate != null)
        {
            @EmptyTemplate
        }
        else
        {
            <p>No items to display</p>
        }
    </div>
}
else
{
    <div class="@GetCombinedClass("bzc-carousel-box")" style="@GetContainerStyle()" @ref="_carouselRef" data-item-count="@ItemCount" role="region" aria-roledescription="carousel" aria-label="Carousel" tabindex="0" data-variant="@Variant.ToString().ToLowerInvariant()" data-navigation="@((ShowNavigation && ItemCount > 1).ToString().ToLowerInvariant())"
        @attributes="AdditionalAttributes">
        <div class="swiper-container bzc-pending">
            <div class="swiper-wrapper">
                @{
                    var index = 0;
                    foreach (var item in Items!)
                    {
                        var currentIndex = index;
                        <div class="swiper-slide" @onclick="() => HandleItemClick(item)">
                            <div class="bzc-slide-inner">
                                @GetItemContent(item, currentIndex)
                            </div>
                            @if (OnItemSelected.HasDelegate)
                            {
                                <button type="button" class="bzc-select" aria-label="@($"Select item {currentIndex + 1}")"
                                        @onclick="() => HandleItemClick(item)" @onclick:stopPropagation="true">✓</button>
                            }
                            @if (ShowOverlay)
                            {
                                <div class="bzc-overlay"></div>
                            }
                        </div>
                        index++;
                    }
                }
            </div>
        </div>
        @if (ShowNavigation && ItemCount > 1)
        {
            <div class="bzc-navigation" data-style="@NavigationStyle.ToString().ToLowerInvariant()" role="group" aria-label="Carousel navigation">
                @if (NavigationStyle == BzCarouselNavigation.Arrows)
                {
                    <button type="button" class="bzc-previous" aria-label="Previous slide" disabled>←</button>
                    <button type="button" class="bzc-next" aria-label="Next slide" disabled>→</button>
                }
                else
                {
                    @for (var dotIndex = 0; dotIndex < ItemCount; dotIndex++)
                    {
                        <button type="button" class="bzc-dot" data-bzc-index="@dotIndex"
                                aria-label="@($"Go to slide {dotIndex + 1}")" disabled></button>
                    }
                }
            </div>
        }
        <span class="bzc-status" aria-live="polite" aria-atomic="true"></span>
    </div>
}
