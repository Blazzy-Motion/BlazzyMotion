<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazzyMotion.Bento\BlazzyMotion.Bento.csproj" />
    <ProjectReference Include="..\BlazzyMotion.Carousel\BlazzyMotion.Carousel.csproj" />
    <ProjectReference Include="..\BlazzyMotion.Core\BlazzyMotion.Core.csproj" />
    <ProjectReference Include="..\BlazzyMotion.Gallery\BlazzyMotion.Gallery.csproj" />
    <ProjectReference Include="..\BlazzyMotion.Marquee\BlazzyMotion.Marquee.csproj" />
    <ProjectReference Include="..\BlazzyMotion.SourceGen\BlazzyMotion.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.19" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>


  <!-- Demo versions follow the same MSBuild properties as the packages. -->
  <ItemGroup>
    <AssemblyMetadata Include="BlazzyMotion.Core.Version" Value="$(BlazzyCoreVersion)" />
    <AssemblyMetadata Include="BlazzyMotion.Carousel.Version" Value="$(BlazzyCarouselVersion)" />
    <AssemblyMetadata Include="BlazzyMotion.Bento.Version" Value="$(BlazzyBentoVersion)" />
    <AssemblyMetadata Include="BlazzyMotion.Gallery.Version" Value="$(BlazzyGalleryVersion)" />
    <AssemblyMetadata Include="BlazzyMotion.Marquee.Version" Value="$(BlazzyMarqueeVersion)" />
  </ItemGroup>
  <!-- This project disables the SDK assembly-info file; emit only the Demo metadata. -->
  <Target Name="GenerateDemoPackageMetadata" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_DemoVersionAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>%(AssemblyMetadata.Identity)</_Parameter1>
        <_Parameter2>%(AssemblyMetadata.Value)</_Parameter2>
      </_DemoVersionAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#" AssemblyAttributes="@(_DemoVersionAttribute)"
                       OutputFile="$(IntermediateOutputPath)DemoPackageVersions.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)DemoPackageVersions.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)DemoPackageVersions.g.cs" />
    </ItemGroup>
  </Target>
</Project>
