@page "/"
@layout HomeLayout
@using BlazzyMotion.Core.Models
@using BlazzyMotion.Carousel.Components
@using BlazzyMotion.Demo.Model
@using BlazzyMotion.Demo.Components
@using BlazzyMotion.Demo.Icons

<PageTitle>BlazzyMotion - Expressive Blazor Components</PageTitle>

<div class="bz-home home-editorial">
    <div class="home-introduction">
        <section class="home-intro" aria-labelledby="home-title">
            <span class="site-eyebrow home-intro__eyebrow"><span class="home-mark" aria-hidden="true"><i></i><i></i><i></i></span> Crafted for Blazor</span>
            <h1 id="home-title">Make room <br />for motion.</h1>
            <p>Bring your models to life with expressive components, four built-in themes, and less configuration.</p>
            <div class="home-intro__actions">
                <a href="/components" class="bz-btn bz-btn--primary">Explore components <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
                <a href="/docs/installation" class="bz-btn bz-btn--secondary">Get started</a>
            </div>
            <div class="home-intro__note"><span>Carousel</span><span>Bento</span><span>Gallery</span><span>Marquee</span></div>
        </section>

        <section class="bz-demo home-showcase" id="demo" aria-labelledby="home-demo-title">
            <div class="home-showcase__heading">
                <div><span class="site-eyebrow">Touch. Swipe. Explore.</span><h2 id="home-demo-title">A different perspective.</h2></div>
                <a href="/carousel">Carousel playground <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
            </div>
            <BzThemePicker @bind-CurrentTheme="_currentTheme" />
            <DemoSurface>
                <div class="bz-demo__stage">
                    <BzCarousel TItem="Movie" Items="@_movies" Theme="@_currentTheme" OnItemSelected="@OnItemSelected" />
                </div>
            </DemoSurface>
            <div class="home-showcase__caption">
                <span class="bz-selected-title">@(_selectedMovie?.Title ?? "Movie collection")</span>
                <span>Swipe, or focus and use the arrow keys.</span>
            </div>
        </section>
    </div>

    <section class="home-principles" aria-label="Built for your workflow">
        <div><span class="home-principles__number">01</span><div><h2>Your data, on display.</h2><p>Map model properties with attributes and let source generators create the templates.</p></div></div>
        <div><span class="home-principles__number">02</span><div><h2>One component. Your style.</h2><p>Choose Glass, Dark, Light or Minimal, then explore the settings in each playground.</p></div></div>
        <div><span class="home-principles__number">03</span><div><h2>Try it. Take the code.</h2><p>Adjust a working example and copy the matching Razor into your project.</p></div></div>
    </section>

    <ComponentDirectory />

    <section class="home-developer" aria-labelledby="home-developer-title">
        <div>
            <span class="site-eyebrow">From model to motion</span>
            <h2 id="home-developer-title">Keep your data.<br />Skip the repetitive markup.</h2>
            <p>Mark the properties you want to show. Bind your collection. Start with the generated template or provide your own.</p>
            <a href="/docs/quick-start">Build your first example <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
        </div>
        <div class="home-developer__code">
            <CodeBlock Language="razor" Code="@QuickExample" />
            <details class="home-model"><summary>Model attributes</summary><CodeBlock Language="csharp" Code="@ModelExample" /></details>
        </div>
    </section>

    <section class="home-next" aria-labelledby="home-next-title">
        <div><span class="site-eyebrow">Make it yours</span><h2 id="home-next-title">Find the right motion for your next idea.</h2></div>
        <a href="/components" class="bz-btn bz-btn--primary">Explore the collection <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
    </section>
</div>
