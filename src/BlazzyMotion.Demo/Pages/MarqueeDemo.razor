@page "/marquee"
@layout HomeLayout
@using BlazzyMotion.Core.Models
@using BlazzyMotion.Marquee.Components
@using BlazzyMotion.Marquee.Models
@using BlazzyMotion.Demo.Model
@using BlazzyMotion.Demo.Components

<PageTitle>BzMarquee Demo - BlazzyMotion</PageTitle>

<div class="bz-home demo-example">

    <ExampleHeader Title="Marquee" Description="Continuous motion for logos, testimonials and text."
                   PackageName="BlazzyMotion.Marquee" Version="@BlazzyMotion.Demo.Services.AppVersions.Marquee" />

    @* ==================== LOGO BAR ==================== *@
    <section class="bzb-presentation">
        <ExampleCode ExampleId="marquee-logos" Code="@LogoCode" ModelCode="@LogoModelCode" DocumentationUrl="/docs/marquee" Title="Logo bar" Description="Settings apply to all examples.">
            <div class="example-theme-controls"><BzThemePicker @bind-CurrentTheme="_currentTheme" /></div>

            <div class="bzg-demo-controls" role="group" aria-label="Marquee settings">
                <div class="bzg-demo-controls__row bzg-demo-controls__row--primary">
                    <div class="bzg-demo-control">
                        <label id="direction-label">Direction</label>
                        <div class="bzg-demo-pills" role="group" aria-labelledby="direction-label">
                            <button class="bzg-demo-pill @(_direction == BzDirection.Left ? "active" : "")"
                                    aria-pressed="@((_direction == BzDirection.Left).ToString().ToLowerInvariant())"
                                    @onclick="@(() => _direction = BzDirection.Left)">Left</button>
                            <button class="bzg-demo-pill @(_direction == BzDirection.Right ? "active" : "")"
                                    aria-pressed="@((_direction == BzDirection.Right).ToString().ToLowerInvariant())"
                                    @onclick="@(() => _direction = BzDirection.Right)">Right</button>
                        </div>
                    </div>

                    <div class="bzg-demo-control">
                        <label for="speed-range">Speed: @_speed</label>
                        <input id="speed-range" type="range" min="10" max="200" step="10"
                               aria-valuemin="10" aria-valuemax="200" aria-valuenow="@_speed"
                               @bind="_speed" @bind:event="oninput" />
                    </div>
                </div>
                <details class="playground-options">
                    <summary>Advanced options</summary>
                    <div class="playground-options__content">
                        <div class="bzg-demo-controls__row bzg-demo-controls__row--secondary">
                            <div class="bzg-demo-control">
                                <label for="gap-range">Gap: @(_gap)px</label>
                                <input id="gap-range" type="range" min="10" max="100" step="5"
                                       aria-valuemin="10" aria-valuemax="100" aria-valuenow="@_gap"
                                       @bind="_gap" @bind:event="oninput" />
                            </div>

                            <div class="bzg-demo-control">
                                <label for="rows-range">Rows: @_rows</label>
                                <input id="rows-range" type="range" min="1" max="4" step="1"
                                       aria-valuemin="1" aria-valuemax="4" aria-valuenow="@_rows"
                                       @bind="_rows" @bind:event="oninput" />
                            </div>
                            <div class="bzg-demo-control">
                                <label id="pause-label">Pause on Hover</label>
                                <div class="bzg-demo-pills" role="group" aria-labelledby="pause-label">
                                    <button class="bzg-demo-pill @(_pauseOnHover ? "active" : "")"
                                            aria-pressed="@((_pauseOnHover).ToString().ToLowerInvariant())"
                                            @onclick="@(() => _pauseOnHover = true)">On</button>
                                    <button class="bzg-demo-pill @(!_pauseOnHover ? "active" : "")"
                                            aria-pressed="@((!_pauseOnHover).ToString().ToLowerInvariant())"
                                            @onclick="@(() => _pauseOnHover = false)">Off</button>
                                </div>
                            </div>

                            <div class="bzg-demo-control">
                                <label id="gradient-label">Gradients</label>
                                <div class="bzg-demo-pills" role="group" aria-labelledby="gradient-label">
                                    <button class="bzg-demo-pill @(_showGradients ? "active" : "")"
                                            aria-pressed="@((_showGradients).ToString().ToLowerInvariant())"
                                            @onclick="@(() => _showGradients = true)">On</button>
                                    <button class="bzg-demo-pill @(!_showGradients ? "active" : "")"
                                            aria-pressed="@((!_showGradients).ToString().ToLowerInvariant())"
                                            @onclick="@(() => _showGradients = false)">Off</button>
                                </div>
                            </div>

                            <div class="bzg-demo-control">
                                <label id="fullwidth-label">Full Width</label>
                                <div class="bzg-demo-pills" role="group" aria-labelledby="fullwidth-label">
                                    <button class="bzg-demo-pill @(_fullWidth ? "active" : "")"
                                            aria-pressed="@((_fullWidth).ToString().ToLowerInvariant())"
                                            @onclick="@(() => _fullWidth = true)">On</button>
                                    <button class="bzg-demo-pill @(!_fullWidth ? "active" : "")"
                                            aria-pressed="@((!_fullWidth).ToString().ToLowerInvariant())"
                                            @onclick="@(() => _fullWidth = false)">Off</button>
                                </div>
                            </div>

                            <div class="bzg-demo-control">
                                <label for="variation-range">Speed Var: @(_speedVariation.ToString("F1"))</label>
                                <input id="variation-range" type="range" min="0" max="0.5" step="0.1"
                                       aria-valuemin="0" aria-valuemax="0.5" aria-valuenow="@_speedVariation"
                                       @bind="_speedVariation" @bind:event="oninput" />
                            </div>

                            <div class="bzg-demo-control">
                                <label id="stagger-label">Stagger Entrance</label>
                                <div class="bzg-demo-pills" role="group" aria-labelledby="stagger-label">
                                    <button class="bzg-demo-pill @(_staggerEntrance ? "active" : "")"
                                            aria-pressed="@((_staggerEntrance).ToString().ToLowerInvariant())"
                                            @onclick="@(() => _staggerEntrance = true)">On</button>
                                    <button class="bzg-demo-pill @(!_staggerEntrance ? "active" : "")"
                                            aria-pressed="@((!_staggerEntrance).ToString().ToLowerInvariant())"
                                            @onclick="@(() => _staggerEntrance = false)">Off</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </details>
            </div>

            <div class="bzb-presentation__stage">
                <BzMarquee TItem="LogoItem"
                           Items="@_logos"
                           Theme="@_currentTheme"
                           Direction="@_direction"
                           Speed="@_speed"
                           Gap="@_gap"
                           Rows="@_rows"
                           AlternateDirection="true"
                           SpeedVariation="@_speedVariation"
                           PauseOnHover="@_pauseOnHover"
                           ShowGradientEdges="@_showGradients"
                           FullWidth="@_fullWidth"
                           StaggerEntrance="@_staggerEntrance" />
            </div>
        </ExampleCode>
    </section>

    @* ==================== TESTIMONIALS ==================== *@
    <section class="bzb-presentation">
        <ExampleCode ExampleId="marquee-testimonials" Code="@TestimonialCode" ModelCode="@TestimonialModelCode" DocumentationUrl="/docs/marquee" Title="Testimonials" Description="Scrolling cards mapped from name, avatar and quote.">
            <div class="bzb-presentation__stage">
                <BzMarquee TItem="TestimonialItem"
                           Items="@_testimonials"
                           Theme="@_currentTheme"
                           Direction="@_direction"
                           Speed="@_speed"
                           Gap="@_gap"
                           PauseOnHover="@_pauseOnHover"
                           ShowGradientEdges="@_showGradients"
                           FullWidth="@_fullWidth"
                           StaggerEntrance="@_staggerEntrance" />
            </div>
        </ExampleCode>
    </section>

    @* ==================== TEXT TICKER ==================== *@
    <section class="bzb-presentation">
        <ExampleCode ExampleId="marquee-ticker" Code="@TickerCode" DocumentationUrl="/docs/marquee" Title="Text ticker" Description="A text-only example without an item model.">
            <div class="bzb-presentation__stage">
                <BzMarquee TItem="object"
                           Text="@_tickerText"
                           Theme="@_currentTheme"
                           Direction="@_direction"
                           Speed="@_speed"
                           Gap="@_gap"
                           PauseOnHover="@_pauseOnHover"
                           ShowGradientEdges="@_showGradients"
                           FullWidth="@_fullWidth"
                           StaggerEntrance="@_staggerEntrance" />
            </div>
        </ExampleCode>
    </section>

</div>

@code {
    private BzTheme _currentTheme = BzTheme.Glass;
    private BzDirection _direction = BzDirection.Left;
    private int _speed = 30;
    private int _gap = 40;
    private int _rows = 2;
    private double _speedVariation;
    private bool _pauseOnHover = true;
    private bool _showGradients = true;
    private bool _fullWidth;
    private bool _staggerEntrance = true;

    private string _tickerText = "BlazzyMotion — Premium Blazor Components — Carousel — Bento Grid — Gallery — Marquee — Built with .NET 8";

    private List<LogoItem> _logos = new()
    {
        new() { Name = "Apple", ImageUrl = "images/logos/apple.webp" },
        new() { Name = "Microsoft", ImageUrl = "images/logos/microsoft.webp" },
        new() { Name = "Google", ImageUrl = "images/logos/google.webp" },
        new() { Name = "Amazon", ImageUrl = "images/logos/amazon.webp" },
        new() { Name = "Tesla", ImageUrl = "images/logos/tesla.webp" },
        new() { Name = "Meta", ImageUrl = "images/logos/meta.webp" },
        new() { Name = "Nvidia", ImageUrl = "images/logos/nvidia.webp" },
        new() { Name = "Netflix", ImageUrl = "images/logos/netflix.webp" }
    };

    private List<TestimonialItem> _testimonials = new()
    {
        new()
        {
            Name = "Sarah Chen",
            Avatar = "images/companies/apple.webp",
            Quote = "Dropped in BzBento and had a dashboard layout with staggered animations running in minutes. Looks premium out of the box."
        },
        new()
        {
            Name = "Marcus Rodriguez",
            Avatar = "images/companies/microsoft.webp",
            Quote = "Just tag your model with [BzImage] and the source generator handles everything. Genuinely zero configuration."
        },
        new()
        {
            Name = "Elena Kowalski",
            Avatar = "images/companies/google.webp",
            Quote = "Switched from a React marquee library to BzMarquee. Same result, pure CSS animations, no npm dependencies."
        },
        new()
        {
            Name = "James Okafor",
            Avatar = "images/companies/nvidia.webp",
            Quote = "Each component ships as its own NuGet package — install only what you need. Keeps the bundle lean."
        },
        new()
        {
            Name = "Yuki Tanaka",
            Avatar = "images/companies/tesla.webp",
            Quote = "Four built-in themes meant we matched our brand in one line of code. Glass theme is chef's kiss."
        },
        new()
        {
            Name = "Alex Petrov",
            Avatar = "images/companies/meta.webp",
            Quote = "Works the same in Blazor Server and WebAssembly — deployed to both without changing a single line."
        }
    };
}
