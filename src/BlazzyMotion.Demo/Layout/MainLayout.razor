@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@using BlazzyMotion.Demo.Components

<SiteHeader />
<button class="bz-mobile-toggle" @onclick="OpenSidebarAsync" aria-label="Open documentation navigation" aria-expanded="@_sidebarOpen.ToString().ToLowerInvariant()" aria-controls="docs-dialog">
    <span aria-hidden="true">☰</span> <span>On this site</span>
</button>
<div class="docs-desktop"><NavMenu OnLinkClick="CloseSidebarAsync" /></div>
<dialog id="docs-dialog" class="docs-dialog" @ref="_dialog" @oncancel="CloseSidebarAsync" aria-label="Documentation navigation">
    <NavMenu NavigationId="mobile-docs-navigation" IsOpen="true" OnLinkClick="CloseSidebarAsync" />
</dialog>
<main id="main-content" tabindex="-1" class="bz-main">
    <div class="bz-main__content">@Body</div>
    <SiteFooter />
</main>

@code {
    private bool _sidebarOpen;
    private ElementReference _dialog;
    private IJSObjectReference? _navigation;

    /// <summary>Opens the native modal navigation, containing keyboard focus until it closes.</summary>
    /// <returns>A task representing module loading and opening the navigation.</returns>
    private async Task OpenSidebarAsync()
    {
        _navigation ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/site-navigation.js");
        await _navigation.InvokeVoidAsync("openNavigation", _dialog);
        _sidebarOpen = true;
    }

    /// <summary>Closes mobile navigation and restores the browser-managed invoking focus.</summary>
    /// <returns>A task representing closing the navigation.</returns>
    private async Task CloseSidebarAsync()
    {
        if (_navigation is not null)
        {
            await _navigation.InvokeVoidAsync("closeNavigation", _dialog);
        }
        _sidebarOpen = false;
    }

    /// <summary>Releases the Demo navigation module when the layout is removed.</summary>
    /// <returns>A task representing module disposal.</returns>
    public async ValueTask DisposeAsync()
    {
        if (_navigation is not null)
        {
            await _navigation.DisposeAsync();
        }
    }
}
